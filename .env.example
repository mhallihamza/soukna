# =====================================================================
# Soukna — configuration racine (lue par docker-compose ET les services)
# Copier vers .env puis renseigner. AUCUNE valeur réelle dans git.
# =====================================================================

# --- Base de données (Supabase : Settings > Database > Connection string) ---
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# --- LLM (Mistral) — sans clé : mode heuristique complet ---
MISTRAL_API_KEY=
MISTRAL_MODEL=codestral-latest

# --- Canal WhatsApp (Cloud API Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=soukna-verify
WHATSAPP_TEST_RECIPIENTS=

# --- Canal email (digest quotidien) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Sécurité d'envoi (runbook : phase Contention) ---
# true : AUCUN envoi réel SAUF vers WHATSAPP_TEST_RECIPIENTS
KILL_SWITCH=true

# --- Portail des marchés publics ---
PORTAL_ENABLED=true
DIGEST_HOUR=8

# --- Dashboard (auth) ---
AUTH_SECRET=change-me-soukna
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Dashboard build (figé au build de l'image Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- URL publique (liens d'invitation) ---
APP_URL=http://localhost:3000

# --- Base de connaissances FAQ (DataStax Astra, Data API v2) ---
# Collection avec embedding intègre (service NVIDIA, champ $vectorize) :
# pas d'embedding externe. Créer depuis la console Astra ou scripts/load_kb.py
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_TOKEN=
ASTRA_DB_KEYSPACE=default_keyspace
ASTRA_DB_COLLECTION=souknabase
FAQ_TOP_K=4


# --- Agent de monitoring (tous optionnels, valeurs par défaut) ---------
# MON_WINDOW_H=24                     # fenêtre d'analyse (heures)
# MON_MAX_ERROR_RATE=20               # % max de requêtes en erreur
# MON_MAX_P95_S=120                   # latence p95 max par agent (s)
# MON_MAX_DAILY_COST_USD=5            # budget LLM sur la fenêtre ($)
# MON_MAX_FALLBACK_PCT=50             # % max de pipelines sans LLM
# MON_MAX_PORTAL_STALENESS_H=36       # fraîcheur max du portail (h)
# MON_MAX_PIPELINE_STALENESS_H=30     # fraîcheur max du pipeline (h)
# MON_ALERT_COOLDOWN_H=6              # anti-spam alertes (h)
# MON_ALERT_EMAIL=                    # vide = ADMIN_USERNAME
# MON_ALERT_WHATSAPP=                 # vide = pas d'alerte WhatsApp

# --- Email via API HTTPS (production cloud — SMTP sortant bloqué) ------
# BREVO_API_KEY=xkeysib-...
