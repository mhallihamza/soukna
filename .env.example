# =====================================================================
# Soukna — configuration racine (lue par docker-compose ET les services)
# Copier vers .env puis renseigner. AUCUNE valeur réelle dans git.
# =====================================================================

# --- Base de données (Supabase : Settings > Database > Connection string) ---
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# --- LLM (Mistral) — sans clé : mode heuristique complet ---
MISTRAL_API_KEY=
MISTRAL_MODEL=codestral-latest

# --- Canal WhatsApp (Cloud API Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=soukna-verify
WHATSAPP_TEST_RECIPIENTS=

# --- Canal email (digest quotidien) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Sécurité d'envoi (runbook : phase Contention) ---
# true : AUCUN envoi réel SAUF vers WHATSAPP_TEST_RECIPIENTS
KILL_SWITCH=true

# --- Portail des marchés publics ---
PORTAL_ENABLED=true
DIGEST_HOUR=8

# --- Dashboard (auth) ---
AUTH_SECRET=change-me-soukna
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Dashboard build (figé au build de l'image Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- URL publique (liens d'invitation) ---
APP_URL=http://localhost:3000
